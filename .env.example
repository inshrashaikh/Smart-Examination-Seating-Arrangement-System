# Copy to `.env` and adjust as needed.

# Base URL every service in src/services builds on. Keep `/api` when using the
# Vite dev proxy; use the absolute URL when serving a production build.
VITE_API_URL=/api

# Where the backend actually lives (used by the proxy and the retry banner).
VITE_API_ORIGIN=http://localhost:8080

# true  -> in-memory demo data, no backend required
# false -> real Spring Boot REST API
VITE_USE_MOCKS=false
